{
  "$schema": "https://schema.tauri.app/config/2.11",
  "productName": "Quill",
  "version": "0.1.0",
  "identifier": "com.quill.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quill",
        "width": 900,
        "height": 700,
        "center": true,
        "resizable": true
      },
      {
        "label": "popup",
        "title": "Quill Popup",
        "url": "src/popup/index.html",
        "width": 400,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFJPV0lEOU1rWGFqQ2paSFZ0ZEZ3a1pGSnNZbFZhY0ZkV1RXbFNhV3h3V2xWU2JGSnNTbFpXYkdS ellrZFNWMWxXYkZkV2JGSnNTbFpXYkdS TQo=",
      "endpoints": ["https://example.com/updater/{{target}}/{{arch}}/{{current_version}}"]
    }
  }
}